{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "todo-app-share",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "todo-share-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "todo-share-media"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
